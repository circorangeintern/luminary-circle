@base = http://localhost:3000/api/v1

### register — expect 201 + { success, data: { user, accessToken } }
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "08031234567", "password": "testpass123" }

### register again — expect 409 CONFLICT
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "08031234567", "password": "testpass123" }

### bad phone — expect 400 with details[0].field = "phone"
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "0203123456", "password": "testpass123" }

### login correct — expect 200 + token
POST {{base}}/auth/login
Content-Type: application/json

{ "phone": "08031234567", "password": "testpass123" }

### login correct — expect 200 + token
POST {{base}}/auth/login
X-Session-Id: ses_test_2
Content-Type: application/json

{ "phone": "08035551230", "password": "testpass123" }

### login wrong password — expect 401 "Phone number or password is incorrect"
POST {{base}}/auth/login
Content-Type: application/json

{ "phone": "08031234567", "password": "testpass123!" }

### login nonexistent phone — expect IDENTICAL 401 message
POST {{base}}/auth/login
Content-Type: application/json

{ "phone": "08031234587", "password": "testpass123" }

### GET /auth/me with Authorization: Bearer <token> — expect the user
@token = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJjbXNpdGRjYTQwMDBobndkanNuanhla2Q5Iiwicm9sZSI6IlVTRVIiLCJpYXQiOjE3ODYxMTY4MDEsImV4cCI6MTc4NjIwMzIwMX0.GySIA05MZhfT5Do8jlH3JkyqGvAuoawVhvVd2Ta_S-M

GET {{base}}/auth/me
Authorization: Bearer {{token}}

### GET /auth/me with no header — expect 401
GET {{base}}/auth/me

### register with a dummy token -> 201 (test key always passes)
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "08035551234",
  "password": "testpass123", "captchaToken": "dummy-token" }

### missing captchaToken -> 400, details[0].field = "captchaToken"
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "08035551235", "password": "testpass123" }

### valid registration with captcha -> 201 (test key always passes)
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Turnstile Tester", "phone": "08035551230",
  "password": "testpass123", "captchaToken": "any-non-empty-string" }

### missing captchaToken -> 400, details has ONLY captchaToken
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "08035551238", "password": "testpass123" }

### empty string captchaToken -> 400 (IsNotEmpty catches it)
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "08035551239",
  "password": "testpass123", "captchaToken": "" }

### --- swap TURNSTILE_SECRET_KEY to 2x0000000000000000000000000000000AA, restart, then: ---

### valid body but Cloudflare rejects the token -> 400 CAPTCHA_FAILED
POST {{base}}/auth/register
Content-Type: application/json

{ "displayName": "Test User", "phone": "08035551240",
  "password": "testpass123", "captchaToken": "any-non-empty-string" }
### expect: error.code === "CAPTCHA_FAILED", no account created

### --- swap TURNSTILE_SECRET_KEY back to 1x0000000000000000000000000000000AA before committing ---
