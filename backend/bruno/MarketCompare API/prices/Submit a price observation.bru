example {
  name: 409 Response
  description: Duplicate submission
  
  request: {
    url: {{baseUrl}}/api/v1/prices
    method: POST
    mode: json
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "itemId": "cmrqexjbk00005kdjpmoq2mo3",
