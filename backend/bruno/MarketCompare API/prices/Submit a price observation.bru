}

example {
  name: 429 Response
  description: Rate limit exceeded
  
  request: {
    url: {{baseUrl}}/api/v1/prices
    method: POST
    mode: json
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "itemId": "cmrqexjbk00005kdjpmoq2mo3",
        "unitId": "cmrqexjbk00005kdjpslfsdfc",
        "marketId": "cmrqexjbk00005kdjpsfweroq",
        "price": 2100,
        "note": "price for the big derica"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 429
      text: Too Many Requests
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
