meta {
  name: Browse price submissions, newest first
  type: http
  seq: 2
  tags: [
    prices
  ]
}

get {
  url: {{baseUrl}}/api/v1/prices
  body: none
  auth: inherit
}

params:query {
  itemId: cmrmtby0c000apwdjuuy3cixh
  unitId: cmrmtbv820000pwdjwt3ouvbi
  marketId: cmrmtc86f000fpwdjrju0rwac
  page: 1
  pageSize: 20
}

headers {
  ~X-Session-Id: 
}

example {
  name: 200 Response
  description: Paginated price submissions
  
  request: {
    url: {{baseUrl}}/api/v1/prices
    method: GET
    mode: none
    params:query: {
      itemId: cmrmtby0c000apwdjuuy3cixh
      unitId: cmrmtbv820000pwdjwt3ouvbi
      marketId: cmrmtc86f000fpwdjrju0rwac
      page: 1
      pageSize: 20
    }
  
    headers: {
      ~X-Session-Id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "id": "cmrqexjbk00005kdjpmoq2mo3",
              "item": {
                "id": "cmrqexjbk00005kdjpmoq2mo3",
                "name": "Rice (local)"
              },
              "unit": {
                "id": "cmrqexjbk00005kdjpmoq2mo3",
                "label": "derica"
              },
              "market": {
                "id": "cmrqexjbk00005kdjpmoq2mo3",
                "name": "Mile 3 Market",
                "lga": "Port Harcourt",
                "state": "Rivers"
              },
              "price": 2100,
              "note": null,
              "status": "ACTIVE",
              "source": "REAL_USER",
              "isStale": false,
              "isFlagged": false,
              "flagCount": 0,
              "submitterDisplayName": "Chidi",
              "createdAt": "2026-07-19T09:00:00.000Z"
            }
          ],
          "page": 1,
          "pageSize": 20,
          "totalItems": 156,
          "totalPages": 8
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid query parameters
  
  request: {
    url: {{baseUrl}}/api/v1/prices
    method: GET
    mode: none
    params:query: {
      itemId: cmrmtby0c000apwdjuuy3cixh
      unitId: cmrmtbv820000pwdjwt3ouvbi
      marketId: cmrmtc86f000fpwdjrju0rwac
      page: 1
      pageSize: 20
    }
  
    headers: {
      ~X-Session-Id: 
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
