meta {
  name: Report a price as wrong or outdated
  type: http
  seq: 3
  tags: [
    prices
  ]
}

post {
  url: {{baseUrl}}/api/v1/prices/:id/flag
  body: json
  auth: bearer
}

params:path {
  id: 
}

headers {
  ~X-Session-Id: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "reason": "WRONG_PRICE"
  }
}

example {
  name: 201 Response
  description: Flag recorded
  
  request: {
    url: {{baseUrl}}/api/v1/prices/:id/flag
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "reason": "WRONG_PRICE"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "flagId": "cmrm...",
          "submissionId": "cmrm...",
          "flagCount": 2,
          "submissionStatus": "ACTIVE"
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Not signed in
  
  request: {
    url: {{baseUrl}}/api/v1/prices/:id/flag
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "reason": "WRONG_PRICE"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 404 Response
  description: Price not found
  
  request: {
    url: {{baseUrl}}/api/v1/prices/:id/flag
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "reason": "WRONG_PRICE"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Already reported by this user
  
  request: {
    url: {{baseUrl}}/api/v1/prices/:id/flag
    method: POST
    mode: json
    params:path: {
      id: 
    }
  
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "reason": "WRONG_PRICE"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
