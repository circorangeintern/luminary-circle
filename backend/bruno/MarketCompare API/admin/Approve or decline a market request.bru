meta {
  name: Approve or decline a market request
  type: http
  seq: 4
  tags: [
    admin
  ]
}

patch {
  url: {{baseUrl}}/api/v1/admin/market-requests/:id
  body: json
  auth: bearer
}

params:path {
  id: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "action": "APPROVE"
  }
}

example {
  name: 200 Response
  description: Decision applied
  
  request: {
    url: {{baseUrl}}/api/v1/admin/market-requests/:id
    method: PATCH
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "action": "APPROVE"
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: text
      content: '''
  
      '''
    }
  }
}

example {
  name: 404 Response
  description: Request not found
  
  request: {
    url: {{baseUrl}}/api/v1/admin/market-requests/:id
    method: PATCH
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "action": "APPROVE"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}

example {
  name: 409 Response
  description: Already reviewed
  
  request: {
    url: {{baseUrl}}/api/v1/admin/market-requests/:id
    method: PATCH
    mode: json
    params:path: {
      id: 
    }
  
    body:json: {
      {
        "action": "APPROVE"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
