meta {
  name: Prices held for review
  type: http
  seq: 1
  tags: [
    admin
  ]
}

get {
  url: {{baseUrl}}/api/v1/admin/moderation
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

example {
  name: 200 Response
  description: Moderation queue
  
  request: {
    url: {{baseUrl}}/api/v1/admin/moderation
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "price": {
                "id": "cmrqexjbk00005kdjpmoq2mo3",
                "item": {
                  "id": "cmrqexjbk00005kdjpmoq2mo3",
                  "name": "Rice (local)"
                },
                "unit": {
                  "id": "cmrqexjbk00005kdjpmoq2mo3",
                  "label": "derica"
                },
                "market": {
                  "id": "cmrqexjbk00005kdjpmoq2mo3",
                  "name": "Mile 3 Market",
                  "lga": "Port Harcourt",
                  "state": "Rivers"
                },
                "price": 2100,
                "note": null,
                "status": "ACTIVE",
                "source": "REAL_USER",
                "isStale": false,
                "isFlagged": false,
                "flagCount": 0,
                "submitterDisplayName": "Chidi",
                "createdAt": "2026-07-19T09:00:00.000Z"
              },
              "flagCount": 3,
              "reasons": [
                "WRONG_PRICE",
                "OUTDATED"
              ]
            }
          ]
        }
      '''
    }
  }
}

example {
  name: 403 Response
  description: Not an admin
  
  request: {
    url: {{baseUrl}}/api/v1/admin/moderation
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 403
      text: Forbidden
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
