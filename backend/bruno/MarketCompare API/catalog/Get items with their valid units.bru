meta {
  name: Get items with their valid units
  type: http
  seq: 1
  tags: [
    catalog
  ]
}

get {
  url: {{baseUrl}}/api/v1/items
  body: none
  auth: inherit
}

example {
  name: 200 Response
  description: Items request successful
  
  request: {
    url: {{baseUrl}}/api/v1/items
    method: GET
    mode: none
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "items": [
            {
              "id": "cmrqexjbk00005kdjpmoq2mo3",
              "name": "Rice (local)",
              "localNames": [
                "ofada-type",
                "abakaliki rice"
              ],
              "units": [
                {
                  "id": "cmrqexjbk00005kdjpmoq2mo3",
                  "label": "derica"
                }
              ]
            }
          ]
        }
      '''
    }
  }
}
