meta {
  name: Compare the latest price for an item across markets
  type: http
  seq: 4
  tags: [
    catalog
  ]
}

get {
  url: {{baseUrl}}/api/v1/markets/compare
  body: none
  auth: inherit
}

params:query {
  itemId: cmrmtby0c000apwdjuuy3cixh
  unitId: cmrmtbv820000pwdjwt3ouvbi
}

example {
  name: 200 Response
  description: Comparison result
  
  request: {
    url: {{baseUrl}}/api/v1/markets/compare
    method: GET
    mode: none
