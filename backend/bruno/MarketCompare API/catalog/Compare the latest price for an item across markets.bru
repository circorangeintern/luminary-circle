example {
  name: 400 Response
  description: Invalid item or unit
  
  request: {
    url: {{baseUrl}}/api/v1/markets/compare
    method: GET
    mode: none
    params:query: {
      itemId: cmrmtby0c000apwdjuuy3cixh
      unitId: cmrmtbv820000pwdjwt3ouvbi
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
