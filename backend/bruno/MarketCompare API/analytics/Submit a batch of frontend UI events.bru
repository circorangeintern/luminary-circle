meta {
  name: Submit a batch of frontend UI events
  type: http
  seq: 1
  tags: [
    analytics
  ]
}

post {
  url: {{baseUrl}}/api/v1/events
  body: json
  auth: inherit
}

headers {
  ~Authorization: 
}

body:json {
  {
    "events": [
      {
        "clientEventId": "6f1c9e6a-3b4d-4e2a-9c8f-1a2b3c4d5e6f",
        "name": "comparison_viewed",
        "sessionId": "ses_a1b2c3",
        "screenName": "comparison",
        "responseStatus": "SUCCESS",
        "errorCode": "VALIDATION_ERROR",
        "deviceType": "MOBILE",
        "properties": {
          "itemId": "cmrm...",
          "marketsDisplayed": 3
        },
        "occurredAt": "2026-07-23T10:00:00.000Z"
      }
    ]
  }
}

example {
  name: 202 Response
  description: Batch processed
  
  request: {
    url: {{baseUrl}}/api/v1/events
    method: POST
    mode: json
    headers: {
      ~Authorization: 
    }
  
    body:json: {
      {
        "events": [
          {
            "clientEventId": "6f1c9e6a-3b4d-4e2a-9c8f-1a2b3c4d5e6f",
            "name": "comparison_viewed",
            "sessionId": "ses_a1b2c3",
            "screenName": "comparison",
            "responseStatus": "SUCCESS",
            "errorCode": "VALIDATION_ERROR",
            "deviceType": "MOBILE",
            "properties": {
              "itemId": "cmrm...",
              "marketsDisplayed": 3
            },
            "occurredAt": "2026-07-23T10:00:00.000Z"
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 202
      text: Accepted
    }
  
    body: {
      type: json
      content: '''
        {
          "accepted": 5,
          "duplicates": 1,
          "rejected": 0
        }
      '''
    }
  }
}

example {
  name: 400 Response
  description: Invalid batch
  
  request: {
    url: {{baseUrl}}/api/v1/events
    method: POST
    mode: json
    headers: {
      ~Authorization: 
    }
  
    body:json: {
      {
        "events": [
          {
            "clientEventId": "6f1c9e6a-3b4d-4e2a-9c8f-1a2b3c4d5e6f",
            "name": "comparison_viewed",
            "sessionId": "ses_a1b2c3",
            "screenName": "comparison",
            "responseStatus": "SUCCESS",
            "errorCode": "VALIDATION_ERROR",
            "deviceType": "MOBILE",
            "properties": {
              "itemId": "cmrm...",
              "marketsDisplayed": 3
            },
            "occurredAt": "2026-07-23T10:00:00.000Z"
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
