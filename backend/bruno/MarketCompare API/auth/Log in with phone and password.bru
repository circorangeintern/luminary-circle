meta {
  name: Log in with phone and password
  type: http
  seq: 2
  tags: [
    auth
  ]
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: inherit
}

headers {
  ~X-Session-Id: 
}

body:json {
  {
    "phone": "08031234567",
    "password": "hunter2hunter2"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.data.accessToken);
}

example {
  name: 200 Response
  description: Logged in
  
  request: {
    url: {{baseUrl}}/api/v1/auth/login
    method: POST
    mode: json
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "phone": "08031234567",
        "password": "hunter2hunter2"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "success": true,
          "data": {
            "user": {
              "id": "cmrqexjbk00005kdjpmoq2mo3",
              "displayName": "Chidi",
              "phone": "+2348031234567",
              "role": "USER"
            },
            "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        }
      '''
    }
  }
}

example {
  name: 401 Response
  description: Invalid credentials
  
  request: {
    url: {{baseUrl}}/api/v1/auth/login
    method: POST
    mode: json
    headers: {
      ~X-Session-Id: 
    }
  
    body:json: {
      {
        "phone": "08031234567",
        "password": "hunter2hunter2"
      }
    }
  }
  
  response: {
    headers: {
      Content-Type: application/json
    }
  
    status: {
      code: 401
      text: Unauthorized
    }
  
    body: {
      type: json
      content: '''
        {
          "success": false,
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Invalid phone number",
            "details": [
              {
                "field": "phone",
                "message": "Not a valid Nigerian mobile number"
              }
            ]
          }
        }
      '''
    }
  }
}
